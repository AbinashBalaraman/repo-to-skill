{
  "version": "0.1.0",
  "notes": "Maps package/import names to capabilities, credentials, effect class and gate hints. This catalog is the scaling asset: every entry added improves extraction for every repo. Two hard rules: (1) an ambiguous package must never be resolved by import alone -- mark it ambiguous and let call-site tracing disambiguate; (2) an unknown package must never yield 'requires nothing' -- use external.call with low confidence.",
  "providers": [
    {
      "id": "openai",
      "match": {
        "pypi": ["openai"],
        "npm": ["openai"],
        "cargo": ["async-openai"],
        "go": ["github.com/sashabaranov/go-openai"],
        "maven": ["com.openai:openai-java"],
        "gradle": ["com.openai:openai-java"]
      },
      "capabilities": ["text.generate"],
      "credentials": [{ "name": "OPENAI_API_KEY", "kind": "apikey", "env": "OPENAI_API_KEY" }],
      "effect": "effectful-external",
      "gate_hints": ["spend"]
    },
    {
      "id": "anthropic",
      "match": {
        "pypi": ["anthropic"],
        "npm": ["@anthropic-ai/sdk"],
        "go": ["github.com/anthropics/anthropic-sdk-go"],
        "maven": ["com.anthropic:anthropic-java"],
        "gradle": ["com.anthropic:anthropic-java"]
      },
      "capabilities": ["text.generate"],
      "credentials": [{ "name": "ANTHROPIC_API_KEY", "kind": "apikey", "env": "ANTHROPIC_API_KEY" }],
      "effect": "effectful-external",
      "gate_hints": ["spend"]
    },
    {
      "id": "elevenlabs",
      "match": { "pypi": ["elevenlabs"] },
      "capabilities": ["audio.tts"],
      "credentials": [{ "name": "ELEVENLABS_API_KEY", "kind": "apikey", "env": "ELEVENLABS_API_KEY" }],
      "effect": "effectful-external",
      "gate_hints": ["spend"]
    },
    {
      "id": "replicate",
      "match": { "pypi": ["replicate"], "npm": ["replicate"] },
      "capabilities": ["image.generate", "video.generate"],
      "credentials": [{ "name": "REPLICATE_API_TOKEN", "kind": "apikey", "env": "REPLICATE_API_TOKEN" }],
      "effect": "effectful-external",
      "gate_hints": ["spend"],
      "ambiguous": true,
      "ambiguous_note": "One client, many models. Import alone cannot tell image from video; resolve by inspecting the model ref at the call site."
    },
    {
      "id": "stripe",
      "match": {
        "pypi": ["stripe"],
        "npm": ["stripe"],
        "cargo": ["async-stripe"],
        "go": ["github.com/stripe/stripe-go"],
        "maven": ["com.stripe:stripe-java"],
        "gradle": ["com.stripe:stripe-java"]
      },
      "capabilities": ["payment.charge"],
      "credentials": [{ "name": "STRIPE_API_KEY", "kind": "apikey", "env": "STRIPE_API_KEY" }],
      "effect": "effectful-external",
      "gate_hints": ["spend", "irreversible"]
    },
    {
      "id": "sendgrid",
      "match": {
        "pypi": ["sendgrid"],
        "cargo": ["sendgrid"],
        "go": ["github.com/sendgrid/sendgrid-go"],
        "maven": ["com.sendgrid:sendgrid-java"],
        "gradle": ["com.sendgrid:sendgrid-java"]
      },
      "capabilities": ["notify.message"],
      "credentials": [{ "name": "SENDGRID_API_KEY", "kind": "apikey", "env": "SENDGRID_API_KEY" }],
      "effect": "effectful-external",
      "gate_hints": []
    },
    {
      "id": "twilio",
      "match": {
        "pypi": ["twilio"],
        "npm": ["twilio"],
        "cargo": ["twilio"],
        "go": ["github.com/twilio/twilio-go"],
        "maven": ["com.twilio.sdk:twilio"],
        "gradle": ["com.twilio.sdk:twilio"]
      },
      "capabilities": ["notify.message"],
      "credentials": [{ "name": "TWILIO_AUTH_TOKEN", "kind": "token", "env": "TWILIO_AUTH_TOKEN" }],
      "effect": "effectful-external",
      "gate_hints": ["spend"]
    },
    {
      "id": "boto3",
      "match": {
        "pypi": ["boto3", "botocore"],
        "npm": ["aws-sdk", "@aws-sdk/client-s3"],
        "cargo": ["aws-config"],
        "go": ["github.com/aws/aws-sdk-go", "github.com/aws/aws-sdk-go-v2/config"],
        "maven": ["software.amazon.awssdk:aws-core", "com.amazonaws:aws-java-sdk"],
        "gradle": ["software.amazon.awssdk:aws-core", "com.amazonaws:aws-java-sdk"]
      },
      "capabilities": ["storage.object", "data.query", "queue.publish", "notify.message"],
      "credentials": [{ "name": "AWS_ACCESS_KEY_ID", "kind": "token", "env": "AWS_ACCESS_KEY_ID" }],
      "effect": "effectful-external",
      "gate_hints": [],
      "ambiguous": true,
      "ambiguous_note": "Could be storage, database, queue or notification depending on the client. Import-only detection must lower confidence and never require all four."
    },
    {
      "id": "google-cloud-storage",
      "match": { "pypi": ["google-cloud-storage"], "npm": ["@google-cloud/storage"] },
      "capabilities": ["storage.object"],
      "credentials": [{ "name": "GOOGLE_APPLICATION_CREDENTIALS", "kind": "token", "env": "GOOGLE_APPLICATION_CREDENTIALS" }],
      "effect": "effectful-external",
      "gate_hints": []
    },
    {
      "id": "google-api-python-client",
      "match": { "pypi": ["google-api-python-client", "googleapis-common-protos"] },
      "capabilities": ["http.request"],
      "credentials": [{ "name": "GOOGLE_OAUTH", "kind": "oauth", "env": null }],
      "effect": "effectful-external",
      "gate_hints": [],
      "ambiguous": true,
      "ambiguous_note": "Discovery-based client spanning hundreds of Google APIs, including YouTube publish. Resolve by inspecting the service name and the build() call."
    },
    {
      "id": "google-genai",
      "match": { "pypi": ["google-genai", "google-generativeai"], "npm": ["@google/genai"] },
      "capabilities": ["text.generate", "image.generate"],
      "credentials": [{ "name": "GEMINI_API_KEY", "kind": "apikey", "env": "GEMINI_API_KEY" }],
      "effect": "effectful-external",
      "gate_hints": ["spend"],
      "ambiguous": true,
      "ambiguous_note": "Text and image generation share one client."
    },
    {
      "id": "sqlalchemy",
      "match": { "pypi": ["sqlalchemy", "psycopg2", "psycopg", "pymysql", "asyncpg"] },
      "capabilities": ["data.query", "data.write"],
      "credentials": [{ "name": "DATABASE_URL", "kind": "password", "env": "DATABASE_URL" }],
      "effect": "effectful-external",
      "gate_hints": [],
      "ambiguous": true,
      "ambiguous_note": "Read and write share a session. Resolve by tracing commit()/add() versus select()."
    },
    {
      "id": "prisma",
      "match": { "npm": ["@prisma/client", "prisma"] },
      "capabilities": ["data.query", "data.write", "db.migrate"],
      "credentials": [{ "name": "DATABASE_URL", "kind": "password", "env": "DATABASE_URL" }],
      "effect": "effectful-external",
